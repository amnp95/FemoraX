{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "cpu-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "Kokkos_ENABLE_SERIAL": "ON",
        "Kokkos_ENABLE_OPENMP": "ON",
        "FEMORAX_BUILD_TESTS": "ON",
        "FEMORAX_WERROR": "ON"
      }
    },
    {
      "name": "cpu-debug",
      "displayName": "CPU (Serial + OpenMP), debug",
      "inherits": "cpu-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "Kokkos_ENABLE_DEBUG": "ON",
        "Kokkos_ENABLE_DEBUG_BOUNDS_CHECK": "ON"
      }
    },
    {
      "name": "cpu-release",
      "displayName": "CPU (Serial + OpenMP), release",
      "inherits": "cpu-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "cpu-asan",
      "displayName": "CPU (Serial + OpenMP), AddressSanitizer + UBSan",
      "inherits": "cpu-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "cuda-ampere86",
      "displayName": "CUDA, Ampere 8.6 (RTX 30-series laptop), release",
      "description": "Run 'cmake -P cmake/FetchKokkosSource.cmake' once first (provides nvcc_wrapper).",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "environment": {
        "PATH": "/usr/local/cuda-13.1/bin:$penv{PATH}"
      },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "${sourceDir}/build/_kokkos/kokkos-5.1.0/bin/nvcc_wrapper",
        "FETCHCONTENT_SOURCE_DIR_KOKKOS": "${sourceDir}/build/_kokkos/kokkos-5.1.0",
        "Kokkos_ENABLE_SERIAL": "ON",
        "Kokkos_ENABLE_OPENMP": "OFF",
        "Kokkos_ENABLE_CUDA": "ON",
        "Kokkos_ARCH_AMPERE86": "ON",
        "FEMORAX_BUILD_TESTS": "ON",
        "FEMORAX_WERROR": "ON"
      }
    },
    {
      "name": "s3-base",
      "hidden": true,
      "inherits": "cpu-base",
      "description": "Stampede3 (TACC), generic x86-64: no CPU-specific Kokkos flag, so the build runs on skx, icx and spr nodes. Sources from build/_kokkos and build/_gtest (fetched once on a login node), so compute nodes need no internet. Load scripts/stampede3_env.sh first. OpenSees for the live comparisons: the Intel reference build's launcher, build/reference-s3-intel/OpenSees.sh (scripts/stampede3_opensees.sh).",
      "cacheVariables": {
        "FETCHCONTENT_SOURCE_DIR_KOKKOS": "${sourceDir}/build/_kokkos/kokkos-5.1.0",
        "FETCHCONTENT_SOURCE_DIR_GOOGLETEST": "${sourceDir}/build/_gtest/googletest-1.17.0",
        "FETCHCONTENT_FULLY_DISCONNECTED": "ON",
        "FEMORAX_OPENSEES": "${sourceDir}/build/reference-s3-intel/OpenSees.sh"
      }
    },
    {
      "name": "s3-cpu-debug",
      "displayName": "Stampede3: CPU (Serial + OpenMP), debug",
      "inherits": [
        "s3-base",
        "cpu-debug"
      ]
    },
    {
      "name": "s3-cpu-release",
      "displayName": "Stampede3: CPU (Serial + OpenMP), release",
      "inherits": [
        "s3-base",
        "cpu-release"
      ]
    },
    {
      "name": "s3-cpu-ubsan",
      "displayName": "Stampede3: CPU (Serial + OpenMP), UndefinedBehaviorSanitizer",
      "description": "AddressSanitizer cannot run on Stampede3 compute nodes: they use strict memory accounting (vm.overcommit_memory = 2), which refuses ASan's shadow-memory reservation. UBSan alone needs none; the ASan checks run with the laptop's cpu-asan preset.",
      "inherits": "s3-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=undefined"
      }
    },
    {
      "name": "s3-sycl-pvc",
      "displayName": "Stampede3: Intel GPU (SYCL, Data Center GPU Max / Ponte Vecchio), release",
      "description": "Stampede3 pvc nodes. Load scripts/stampede3_sycl_env.sh first (Intel oneAPI 2026.0: icpx with SYCL). Kokkos' SYCL backend, compiled ahead of time for Ponte Vecchio; host code Serial. Sources from build/_kokkos and build/_gtest. -fp-model=precise: Intel's compilers default to fast math, which reorders and approximates floating-point arithmetic.",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "icpx",
        "CMAKE_C_COMPILER": "icx",
        "Kokkos_ENABLE_SERIAL": "ON",
        "Kokkos_ENABLE_OPENMP": "OFF",
        "Kokkos_ENABLE_SYCL": "ON",
        "Kokkos_ARCH_INTEL_PVC": "ON",
        "FEMORAX_BUILD_TESTS": "ON",
        "FEMORAX_WERROR": "ON",
        "FETCHCONTENT_SOURCE_DIR_KOKKOS": "${sourceDir}/build/_kokkos/kokkos-5.1.0",
        "FETCHCONTENT_SOURCE_DIR_GOOGLETEST": "${sourceDir}/build/_gtest/googletest-1.17.0",
        "FETCHCONTENT_FULLY_DISCONNECTED": "ON",
        "FEMORAX_OPENSEES": "${sourceDir}/build/reference-s3-intel/OpenSees.sh",
        "CMAKE_CXX_FLAGS": "-fp-model=precise",
        "CMAKE_C_FLAGS": "-fp-model=precise"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug"
    },
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release"
    },
    {
      "name": "cpu-asan",
      "configurePreset": "cpu-asan"
    },
    {
      "name": "cuda-ampere86",
      "configurePreset": "cuda-ampere86",
      "environment": {
        "PATH": "/usr/local/cuda-13.1/bin:$penv{PATH}"
      }
    },
    {
      "name": "s3-cpu-debug",
      "configurePreset": "s3-cpu-debug"
    },
    {
      "name": "s3-cpu-release",
      "configurePreset": "s3-cpu-release"
    },
    {
      "name": "s3-cpu-ubsan",
      "configurePreset": "s3-cpu-ubsan"
    },
    {
      "name": "s3-sycl-pvc",
      "configurePreset": "s3-sycl-pvc"
    }
  ],
  "testPresets": [
    {
      "name": "cpu-debug",
      "configurePreset": "cpu-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-release",
      "configurePreset": "cpu-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cpu-asan",
      "configurePreset": "cpu-asan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "cuda-ampere86",
      "configurePreset": "cuda-ampere86",
      "environment": {
        "PATH": "/usr/local/cuda-13.1/bin:$penv{PATH}"
      },
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "s3-cpu-debug",
      "configurePreset": "s3-cpu-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "s3-cpu-release",
      "configurePreset": "s3-cpu-release",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "s3-cpu-ubsan",
      "configurePreset": "s3-cpu-ubsan",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "s3-sycl-pvc",
      "configurePreset": "s3-sycl-pvc",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
